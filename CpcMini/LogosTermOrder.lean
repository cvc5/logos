      match datatypeConsCmp x1 y1 with
      | .eq =>
        datatypeCmp x2 y2
      | o => o
    | _ => natCmp a.ctorIdx b.ctorIdx
termination_by structural a _ => a

@[expose] def datatypeConsCmp : DatatypeCons -> DatatypeCons -> Ordering
