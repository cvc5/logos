  | [], _ :: _ => .lt
  | _ :: _, [] => .gt
  | c :: s, d :: t =>
    match natCmp c d with
    | .eq => stringCmp s t
    | o => o

@[expose] def userOpCmp (a b : UserOp) : Ordering :=
  natCmp a.ctorIdx b.ctorIdx

