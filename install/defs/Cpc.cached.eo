  (($str_arith_entail_simple_rec (@poly (@mon (eo::List::cons (str.len s) t) q) p))
    ($str_arith_entail_simple_rec (@poly (@mon t q) p)))
  (($str_arith_entail_simple_rec (@poly (@mon eo::List::nil q) p))
