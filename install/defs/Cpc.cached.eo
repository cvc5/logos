(program $str_re_consume_rec
  ((s1 String) (s2 String :list) (r1 RegLan) (r2 RegLan :list)
   (s3 String) (s5 String) (r3 RegLan) (fuel String) (fc String) (fr String :list))
  :signature (String RegLan String) Bool
  (
    (($str_re_consume_rec (str.++ s1 s2) (re.++ @re.empty r2) fuel)
