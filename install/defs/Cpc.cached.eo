  (-> (Set T) Bool))
(declare-parameterized-const set.is_singleton ((T Type :implicit))
  (-> (Set T) Bool))
(declare-parameterized-const set.insert ((T Type :implicit))
  (-> (@TList T) (Set T) (Set T)))
(declare-parameterized-const @sets_deq_diff
  ((T Type :implicit) (s (Set T)) (t (Set T)))
  T)
