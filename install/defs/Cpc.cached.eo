          (eo::ite isUnder
            (eo::or ($str_arith_entail_simple_pred (>= lr lt)) ($str_arith_entail_simple_pred (>= lr ls)))
            ($str_arith_entail_simple_pred (>= lt lr)))
        (eo::ite (eo::eq n (+ ls lr))
          (eo::not isUnder)
        (eo::ite (eo::eq n (- ls lt))
