        (eo::ite (eo::eq n (+ n1 1))
          (eo::and (eo::not isUnder) ($str_arith_entail_simple n1))
        (eo::ite (eo::eq n n1)
          (eo::and (eo::not isUnder) ($str_arith_entail_simple_pred (> n1 0)))
