; A cvc5 proof over a parametric datatype whose field uses its own instance at Int.
(declare-datatypes ((L 1)) ((par (X)((nil) (c (h X) (t (L Int)))))))
(declare-const x (L Bool))
(define @t1 () (as nil (L Int)))
(define @t2 () (c 1 @t1))
(define @t3 () (c true @t2))
(define @t4 () (= x @t3))
(define @t5 () (t x))
(define @t6 () (h @t5))
(define @t7 () (= @t6 1))
(define @t8 () (not @t7))
(define @t9 () (c 1 @t1))
(define @t10 () (c true @t9))
(define @t11 () (t @t10))
(define @t12 () (h @t11))
(define @t13 () (= @t12 1))
(define @t14 () (c true @t2))
(assume @p1 @t4)
(assume @p2 @t8)
(step @p3 :rule evaluate :args ((not true)))
(step @p4 :rule evaluate :args ((= 1 1)))
(step @p5 :rule refl :args (1))
(step @p6 :rule dt-collapse-selector :args ((= (h @t9) 1)))
(step @p7 :rule dt-collapse-selector :args ((= @t11 @t9)))
(step @p8 :rule cong :premises (@p7) :args (@t12))
(step @p9 :rule trans :premises (@p8 @p6))
(step @p10 :rule cong :premises (@p9 @p5) :args (@t13))
(step @p11 :rule trans :premises (@p10 @p4))
(step @p12 :rule cong :premises (@p11) :args ((not @t13)))
(step @p13 :rule trans :premises (@p12 @p3))
(step @p14 :rule refl :args (@t2))
(step @p15 :rule refl :args (true))
(step @p16 :rule cong :premises (@p15 @p14) :args (@t14))
(step @p17 :rule refl :args (@t2))
(step @p18 :rule refl :args (true))
(step @p19 :rule cong :premises (@p18 @p17) :args (@t14))
(step @p20 :rule refl :args ((c true @t9)))
(step @p21 :rule cong :premises (@p18 @p17) :args (@t3))
(step @p22 :rule trans :premises (@p21 @p20))
(step @p23 :rule cong :premises (@p22 @p19) :args ((= @t3 @t14)))
(step @p24 :rule symm :premises (@p23))
(step @p25 :rule refl :args (@t10))
(step @p26 :rule eq_resolve :premises (@p25 @p24))
(step @p27 :rule trans :premises (@p26 @p16))
(step @p28 :rule refl :args (x))
(step @p29 :rule cong :premises (@p28 @p27) :args (@t4))
(step @p30 :rule eq_resolve :premises (@p1 @p29))
(step @p31 :rule cong :premises (@p30) :args (@t5))
(step @p32 :rule cong :premises (@p31) :args (@t6))
(step @p33 :rule cong :premises (@p32 @p5) :args (@t7))
(step @p34 :rule cong :premises (@p33) :args (@t8))
(step @p35 :rule trans :premises (@p34 @p13))
(step @p36 false :rule eq_resolve :premises (@p2 @p35))
