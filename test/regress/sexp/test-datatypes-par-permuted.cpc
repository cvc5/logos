; A cvc5 proof over mutually recursive datatypes referring to each other with their parameters swapped.
(declare-datatypes ((B 2)(A 2)) ((par (X Y)((b0) (mkB (ba (A Y X)))))(par (X Y)((a0) (mkA (ab (B Y X)))))))
(declare-const x (A Int Bool))
(define @t1 () (mkB x))
(define @t2 () (mkA @t1))
(define @t3 () (= x @t2))
(define @t4 () (mkB x))
(define @t5 () (mkA @t4))
(define @t6 () (mkA @t1))
(assume @p1 @t3)
(step @p2 :rule dt-cycle :args ((= (= x @t5) false)))
(step @p3 :rule refl :args (@t1))
(step @p4 :rule cong :premises (@p3) :args (@t6))
(step @p5 :rule refl :args (@t1))
(step @p6 :rule cong :premises (@p5) :args (@t6))
(step @p7 :rule refl :args ((mkA @t4)))
(step @p8 :rule cong :premises (@p5) :args (@t2))
(step @p9 :rule trans :premises (@p8 @p7))
(step @p10 :rule cong :premises (@p9 @p6) :args ((= @t2 @t6)))
(step @p11 :rule symm :premises (@p10))
(step @p12 :rule refl :args (@t5))
(step @p13 :rule eq_resolve :premises (@p12 @p11))
(step @p14 :rule trans :premises (@p13 @p4))
(step @p15 :rule refl :args (x))
(step @p16 :rule cong :premises (@p15 @p14) :args (@t3))
(step @p17 :rule eq_resolve :premises (@p1 @p16))
(step @p18 false :rule eq_resolve :premises (@p17 @p2))
