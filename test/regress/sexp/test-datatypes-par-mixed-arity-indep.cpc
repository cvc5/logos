; A cvc5 proof over a block of independent datatypes of arities 1 and 2.
(declare-datatypes ((B 2)) ((par (X Y)((mkB (bv X) (bw Y))))))
(declare-datatypes ((A 1)) ((par (X)((mkA (av X))))))
(declare-const p (B Int Bool))
(declare-const q (A Int))
(define @t1 () (av q))
(define @t2 () (mkA @t1))
(define @t3 () (= q @t2))
(define @t4 () (not @t3))
(define @t5 () (bw p))
(define @t6 () (bv p))
(define @t7 () (mkB @t6 @t5))
(define @t8 () (= p @t7))
(define @t9 () (not @t8))
(define @t10 () (or @t9 @t4))
(define @t11 () (@purify @t5))
(define @t12 () (mkB @t6 @t5))
(define @t13 () (= p @t12))
(define @t14 () (is mkB p))
(define @t15 () (= q (mkA @t1)))
(define @t16 () (not @t15))
(define @t17 () (not @t13))
(define @t18 () (= p (mkB @t6 @t11)))
(define @t19 () (is mkA q))
(assume @p1 @t10)
(step @p2 :rule refl :args (true))
(step @p3 :rule true_elim :premises (@p2))
(step @p4 :rule eq-refl :args (@t5))
(step @p5 :rule skolem_intro :args (@t11))
(step @p6 :rule refl :args (@t5))
(step @p7 :rule cong :premises (@p6 @p5) :args ((= @t5 @t11)))
(step @p8 :rule trans :premises (@p7 @p4))
(step @p9 :rule true_elim :premises (@p8))
(step @p10 :rule refl :args (@t6))
(step @p11 :rule cong :premises (@p10 @p9) :args (@t12))
(step @p12 :rule refl :args (p))
(step @p13 :rule cong :premises (@p12 @p11) :args (@t13))
(step @p14 :rule bool-impl-true2 :args (@t13))
(step @p15 :rule refl :args (@t13))
(step @p16 :rule dt-collapse-tester-singleton :args ((= @t14 true)))
(step @p17 :rule cong :premises (@p16 @p15) :args ((=> @t14 @t13)))
(step @p18 :rule trans :premises (@p17 @p14))
(step @p19 :rule trans :premises (@p18 @p13))
(assume-push @p54 @t14)
(step @p21 :rule dt-inst :args ((= @t14 @t13)))
(step @p22 :rule eq_resolve :premises (@p54 @p21))
(step-pop @p55 :rule scope :premises (@p22))
(step @p23 :rule process_scope :premises (@p55) :args (@t13))
(step @p25 :rule eq_resolve :premises (@p23 @p19))
(step @p26 :rule refl :args (@t16))
(step @p27 :rule cong :premises (@p13) :args (@t17))
(step @p28 :rule nary_cong :premises (@p27 @p26) :args ((or @t17 @t16)))
(step @p29 :rule refl :args (@t2))
(step @p30 :rule refl :args (q))
(step @p31 :rule cong :premises (@p30 @p29) :args (@t3))
(step @p32 :rule cong :premises (@p31) :args (@t4))
(step @p33 :rule refl :args (@t7))
(step @p34 :rule cong :premises (@p12 @p33) :args (@t8))
(step @p35 :rule cong :premises (@p34) :args (@t9))
(step @p36 :rule nary_cong :premises (@p35 @p32) :args (@t10))
(step @p37 :rule trans :premises (@p36 @p28))
(step @p38 :rule eq_resolve :premises (@p1 @p37))
(step @p39 :rule reordering :premises (@p38) :args ((or @t16 (not @t18))))
(step @p40 :rule chain_m_resolution :premises (@p39 @p25) :args (@t16 (@list false) (@list @t18)))
(assume-push @p56 true)
(assume-push @p57 @t19)
(step @p43 :rule dt-inst :args ((= @t19 @t15)))
(step @p44 :rule dt_split :args (q))
(step @p45 :rule eq_resolve :premises (@p44 @p43))
(step-pop @p58 :rule scope :premises (@p45))
(step @p46 :rule process_scope :premises (@p58) :args (@t15))
(step @p48 :rule dt_split :args (q))
(step @p49 :rule modus_ponens :premises (@p48 @p46))
(step-pop @p59 :rule scope :premises (@p49))
(step @p50 :rule process_scope :premises (@p59) :args (@t15))
(step @p52 :rule implies_elim :premises (@p50))
(step @p53 false :rule chain_m_resolution :premises (@p52 @p40 @p3) :args (false (@list true false) (@list @t15 true)))
