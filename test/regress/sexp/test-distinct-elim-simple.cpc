; The s-expression form of test/regress/test-distinct-elim-simple.cpc.lean.
(declare-const x Int)
(declare-const y Int)
(declare-const z Int)
(assume @p0 (distinct z y x))
(assume @p1 (or (= z y) (= y x)))
(step @p2 :rule distinct-elim
  :args ((= (distinct z y x)
            (and (not (= z y)) (not (= z x)) (not (= y x))))))
(step @p3 :rule eq_resolve :premises (@p0 @p2))
(step @p4 :rule and_elim :premises (@p3) :args (2))
(step @p5 :rule and_elim :premises (@p3) :args (0))
(step @p6 :rule cnf_or_pos :args ((or (= z y) (= y x))))
(step @p7 :rule chain_resolution :premises (@p6 @p5 @p4)
  :args ((@list true true) (@list (= z y) (= y x))))
(step @p8 :rule contra :premises (@p1 @p7))
