; Exercises declare-datatypes: a recursive datatype, its constructors and testers.
(declare-datatypes ((List 0)) (((cons (head Int) (tail List)) (nil))))
(declare-const x List)
(assume @p0 (not (= ((_ is cons) x) ((_ is cons) x))))
(step @p1 :rule refl :args (((_ is cons) x)))
(step @p2 :rule contra :premises (@p1 @p0))
